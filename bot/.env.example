# Copy file ini jadi .env lalu isi token bot kamu
# ⚠️ JANGAN PERNAH share file .env / token ke siapapun

# --- wajib ---
DISCORD_TOKEN=

# --- umum ---
COMMAND_PREFIX=!
# GUILD_ID: isi ID server untuk sync slash command instan (mode 1 server).
# Kosongkan / 0 = bot PUBLIK: command di-sync global ke semua server
# (butuh waktu ±1 jam sampai muncul di server yang baru invite).
GUILD_ID=0
WELCOME_CHANNEL_ID=0

# --- moderasi ---
MOD_LOG_CHANNEL_ID=0
ANTI_INVITE=true
SPAM_MAX_MESSAGES=5
SPAM_WINDOW_SECONDS=5
MUTE_DURATION_MINUTES=10

# --- verifikasi ---
# Bisa dioverride per-server via dashboard (Pengaturan > Verifikasi).
VERIFY_CHANNEL_ID=0
VERIFIED_ROLE_NAME=Member
UNVERIFIED_ROLE_NAME=Belum Verifikasi

# --- tiket ---
# Bisa dioverride per-server via dashboard (Pengaturan > Tiket Support).
TICKET_CATEGORY_ID=0

# --- fitur komunitas ---
SELF_ROLES=Pioneer,Notifikasi Event,Mabar
# Bisa dioverride per-server via dashboard (Pengaturan > Komunitas / Temp Voice).
SARAN_CHANNEL_ID=0
TEMPVC_LOBBY_ID=0
TEMPVC_CATEGORY_ID=0

# --- xp & leveling ---
XP_PER_MESSAGE=15
XP_COOLDOWN_SECONDS=60
LEVEL_ROLES=5:Aktif,10:Veteran,20:Sepuh
VOICE_XP_PER_MIN=5

# --- economy (koin) ---
ECONOMY_START_BALANCE=100
ECONOMY_DAILY_MIN=100
ECONOMY_DAILY_MAX=300
ECONOMY_WORK_MIN=50
ECONOMY_WORK_MAX=150
ECONOMY_WORK_COOLDOWN=3600
ECONOMY_LEVEL_BONUS=50
ECONOMY_MIN_BET=10
ECONOMY_MAX_BET=5000
ECONOMY_TRIVIA_REWARD=100
ECONOMY_TRIVIA_COOLDOWN=300

# --- shop (format: "NamaRole:harga,NamaRole:harga" — role harus sudah ada di server) ---
SHOP_ITEMS=

# --- counting channel ---
# Bisa dioverride per-server via dashboard (Pengaturan > Komunitas).
COUNTING_CHANNEL_ID=0

# --- youtube ---
YT_CHANNEL_ID=
YT_NOTIFY_CHANNEL_ID=0
YT_CHECK_MINUTES=15
YT_PING_ROLE_ID=0

# --- auto-mod ---
BAD_WORDS=anjing,bangsat,tolol,goblok,bego,babi,jancuk,jancok,asw
WARN_MAX=3

# --- starboard ---
STARBOARD_CHANNEL_ID=0
STARBOARD_MIN=3

# --- server stats ---
STATS_TOTAL_ID=0
STATS_HUMAN_ID=0
STATS_BOT_ID=0

# --- bank, lotre, gaji ---
BANK_BUNGA_HARIAN=2
LOTRE_HARGA_TIKET=100
GAJI_ROLES=

# --- reward perilaku ---
INVITE_KOIN=200
STARBOARD_KOIN=50
VOICE_KOIN_PER_MIN=2
ULTAH_KOIN=200

# --- season & leveling ---
SEASON_HARI=90
XP_WEEKEND_BOOST=1

# --- minigames+ ---
MALING_COOLDOWN=3600
SUSUNKATA_REWARD=150
SUSUNKATA_COOLDOWN=600

# --- twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
TWITCH_NOTIFY_CHANNEL_ID=0
TWITCH_CHECK_MINUTES=15

# --- Tahap 12: economy+ ---
TRADE_TIMEOUT=120
PINJAMAN_MAKS=5000
PINJAMAN_BUNGA_HARIAN=5
PINJAMAN_TENOR_HARI=7
DEPOSITO_PILIHAN=7:3,30:8
SAHAM_UPDATE_MENIT=60

# --- Tahap 12: games ---
TURNAMEN_HADIAH=1000
KUIS_JUMLAH_SOAL=5
KUIS_REWARD=50

# --- Tahap 12: leveling & sosial ---
REACTION_XP=2
REACTION_COOLDOWN=60
LEVEL_ROLES_VOICE=
# Bisa dioverride per-server via dashboard (Pengaturan > Komunitas).
CONFESS_CHANNEL_ID=0
NIKAH_BONUS_HARIAN=50
CLAN_BIAYA=1000
CLAN_WAR_HADIAH=2000

# --- Tahap 12: engagement ---
PET_HARGA=500
QUEST_GUILD_TARGET=2000
QUEST_GUILD_HADIAH=300
BUMP_KOIN=100
# Bisa dioverride per-server via dashboard (Pengaturan > Komunitas).
DAILYQ_CHANNEL_ID=0
DAILYQ_REWARD=25
DAILYQ_MAKS=20

# --- Tahap 12: utilitas ---
BACKUP_CHANNEL_ID=0
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1
TIKET_SLA_JAM=24
# --- Dashboard web (Next.js): kosongkan keduanya untuk mematikan sinkronisasi ---
# PERINGATAN: DASHBOARD_URL WAJIB https:// bila menunjuk host publik —
# DASHBOARD_SECRET dikirim via header Authorization di tiap request,
# jadi http:// membocorkannya ke jaringan. Pengecualian: localhost/127.0.0.1
# (pengembangan lokal). Bot menolak startup bila aturan ini dilanggar.
DASHBOARD_URL=
DASHBOARD_SECRET=
