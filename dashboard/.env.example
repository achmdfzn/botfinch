# Copy file ini jadi .env.local lalu isi manual — JANGAN commit file .env.local
# ⚠️ JANGAN PERNAH share nilai secret di file ini ke siapapun

# --- autentikasi (Auth.js + Discord OAuth2) ---
AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Sama dengan Client ID (publik, dipakai tombol invite)
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# --- database (Vercel Postgres) ---
POSTGRES_URL=

# --- sinkronisasi bot <-> dashboard ---
# Buat acak sendiri 32+ karakter. Samakan persis dengan DASHBOARD_SECRET di .env bot.
DASHBOARD_SECRET=

# --- owner bot (panel admin entitlement Free/VIP) ---
# Server-side SAJA: JANGAN PERNAH pakai prefix NEXT_PUBLIC_ untuk variabel ini,
# karena nilai NEXT_PUBLIC_* terekspos ke browser semua pengunjung.
# Isi ID Discord owner bot, dipisah koma bila lebih dari satu.
BOT_OWNER_IDS=

# --- billing / payment gateway (Finch Premium VIP) ---
# Server-side SAJA: JANGAN PERNAH pakai prefix NEXT_PUBLIC_ untuk secret
# di blok ini, karena nilai NEXT_PUBLIC_* terekspos ke browser pengunjung.
# Billing aktif hanya bila PAYMENT_PROVIDER terisi valid, credential
# provider itu lengkap, dan harga valid (default katalog atau override
# BILLING_VIP_PRICE_IDR yang valid). Lihat BILLING.md.

# Provider aktif: "midtrans" atau "xendit". Kosong = billing nonaktif (checkout 503).
PAYMENT_PROVIDER=
# Midtrans: Server Key dari dashboard Midtrans (Settings > Access Keys).
MIDTRANS_SERVER_KEY=
# Midtrans: Client Key (publik; untuk snap.js bila nanti dipakai, bukan secret server).
MIDTRANS_CLIENT_KEY=
# Midtrans: false = sandbox (app.sandbox/api.sandbox), true = production.
MIDTRANS_IS_PRODUCTION=false
# Xendit: Secret API Key dari dashboard Xendit (Settings > Developers > API Keys).
XENDIT_SECRET_KEY=
# Xendit: Webhook Verification Token dari dashboard Xendit (Settings > Developers > Webhooks).
XENDIT_CALLBACK_TOKEN=
# Xendit: dicadangkan untuk penanda mode test/live key; API Invoice v2 memakai
# base URL yang sama untuk test & live (dibedakan oleh jenis secret key).
XENDIT_IS_PRODUCTION=false
# Harga plan VIP bulanan (1 bulan = 30 hari) dalam rupiah.
# Kosong = harga default katalog 65000. Isi HANYA digit murni TANPA
# titik/koma/desimal (contoh: 50000) untuk mengoverride harga default.
# Terisi tapi invalid (non-digit, 0, negatif, desimal) = billing nonaktif
# fail-closed (checkout 503), BUKAN diam-diam kembali ke harga default.
BILLING_VIP_PRICE_IDR=
# Base URL publik dashboard (contoh: https://dashboard.example.com) untuk
# membangun URL kembali setelah pembayaran. Kosong = pakai origin request.
APP_BASE_URL=
