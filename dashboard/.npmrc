# Melewati strict peer-dependency resolution saat npm install.
# Alasan: vitest (devDependency, hanya untuk unit test) mendeklarasikan
# peerOptional @types/node@^22 || >=24, sedangkan proyek memakai @types/node@^20.
# Tanpa ini, `npm install` di Vercel gagal dengan ERESOLVE.
# Aman: vitest tidak ikut ke production build; ini hanya memengaruhi resolusi install.
legacy-peer-deps=true
